# The easy way: run `zuspy setup` and paste your keys in the page it opens.
# They're saved in ~/.zuspy/.env (outside every project). Or copy this file to .env in the folder you run ZuSpy from.
# Never commit a .env file.

# Required: Google Maps, Google reviews and Google's ad library (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=you@yourbusiness.com
DATAFORSEO_PASSWORD=your_api_password

# The AI that writes the analysis. None set = Claude Code writes it (run ZuSpy from Claude Code).
# ANTHROPIC_API_KEY=sk-ant-...        Claude Sonnet 5.5 through Anthropic's API (about $0.10 a report)
# OPENROUTER_API_KEY=sk-or-...        or OpenRouter
# ZURELAY_API_KEY=zr_live_...         or Zurelay
# ZUSPY_AI_BASE_URL=https://api.openai.com/v1   or any OpenAI-compatible API, with:
# ZUSPY_AI_KEY=...
# ZUSPY_MODEL=...
# ZUSPY_AI=anthropic|openrouter|zurelay|openai|claude-code   pick one when several keys are set

# Optional
# FIRECRAWL_API_KEY=fc-...            backup reader for Meta's Ad Library (your own Chrome/Edge is used first)
# ZUSPY_BROWSER=/path/to/chrome       when your browser isn't found by itself
# ZUSPY_META=auto|browser|firecrawl|off
# ZUSPY_DIR=./zuspy-reports           where reports are saved
# ZUSPY_EFFORT=low                    how hard the AI thinks (low is plenty and keeps a report under a minute)
# ZUSPY_READER_MODEL=claude-haiku-5-5 the small model that reads the words on Google's ad pictures
